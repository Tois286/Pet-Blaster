# ============================================================
# Pet Blaster - konfigurasi PRODUCTION
# Salin menjadi file bernama  .env  di root proyek, di SERVER (jangan commit .env).
# Ganti semua nilai bertanda GANTI_...
# ============================================================
CI_ENVIRONMENT = production

# Alamat situs, WAJIB https dan diakhiri garis miring
app.baseURL = 'https://GANTI_DOMAIN_ANDA/'
# Paksa semua akses ke HTTPS
app.forceGlobalSecureRequests = true

# Cookie sesi hanya dikirim lewat HTTPS
cookie.secure = true
cookie.samesite = 'Lax'

# Database: pakai user KHUSUS game (bukan root) dengan hak SELECT/INSERT/UPDATE/DELETE saja.
# Hak ALTER/CREATE hanya dibutuhkan sementara saat menjalankan: php spark game:migrate
database.default.hostname = localhost
database.default.database = GANTI_NAMA_DATABASE
database.default.username = GANTI_USER_DATABASE
database.default.password = GANTI_PASSWORD_DATABASE
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.DBDebug = false
